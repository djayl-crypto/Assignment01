{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assignment01",
  "account_id": "ecb2b3e0f21e1a755c6b2f3a1c0f4219",
  "main": ".wrangler/city-fit/worker.py",
  "build": { "command": "python build_worker.py" },
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "preview_urls": false,
  "find_additional_modules": true,
  "assets": {
    "directory": "./static",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
